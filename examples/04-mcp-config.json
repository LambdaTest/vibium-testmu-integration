{
  "_comment": [
    "MCP configuration for driving a TestMu AI cloud browser from an AI agent.",
    "Works with Claude Code, Claude Desktop, Cursor, and any other MCP client.",
    "",
    "Replace VIBIUM_CONNECT_API_KEY with base64('username:accessKey'):",
    "    printf '%s:%s' \"$LT_USERNAME\" \"$LT_ACCESS_KEY\" | base64 | tr -d '\\n'",
    "",
    "The agent then drives a cloud browser without ever being told about",
    "TestMu AI — the user just says what they want checked, and the browser",
    "happens to be in the cloud.",
    ""
  ],

  "mcpServers": {
    "vibium": {
      "command": "vibium",
      "args": ["mcp"],
      "env": {
        "VIBIUM_CONNECT_URL": "wss://cdp.lambdatest.com/vibium",
        "VIBIUM_CONNECT_API_KEY": "<base64 of username:accessKey>"
      }
    },

    "_vibium_windows10_example": {
      "command": "vibium",
      "args": ["mcp"],
      "env": {
        "VIBIUM_CONNECT_URL": "wss://cdp.lambdatest.com/vibium?capabilities=%7B%22LT%3AOptions%22%3A%7B%22platformName%22%3A%22Windows%2010%22%7D%7D",
        "VIBIUM_CONNECT_API_KEY": "<base64 of username:accessKey>"
      }
    }
  }
}
